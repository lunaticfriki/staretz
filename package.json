{
  "name": "staretz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "bash scripts/e2e.sh",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "arch-test": "depcruise src",
    "dev:tmux": "bash scripts/dev-tmux.sh",
    "prepare": "husky",
    "deploy": "pnpm build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@preact/signals": "^2.9.4",
    "@preact/signals-core": "^1.14.4",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.16.0",
    "inversify": "^8.2.1",
    "marked": "^18.0.6",
    "preact": "^10.29.3",
    "preact-router": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.13.2",
    "dependency-cruiser": "^18.1.0",
    "firebase-tools": "^15.24.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "ts-mockito": "^2.6.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
